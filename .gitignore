# ════════════════════════════════════════════════════════════════════
#  Nai-Long-Adventure · 版本库纳管规则
#  判据：删掉它，能不能一条命令重新得到 —— 能，就不进版本库
#  纳管范围：仅 UE 侧（UE5/ + NaiwaCharacter/ + NaiwaAnimation_20261009/）
#  SFML 部分（根目录源码 / out/ / .vs/）不在此规则内
#  最后更新：2026-10-13
#
#  写法约定：优先「全局排除 + 定点放回」，而不是「逐个目录排除」。
#  原因：白名单式规则必然漏（本轮已实测漏过 .cpp/.h/.cs、.ini、
#  rebuild_command.ps1、references/ 配图），黑名单式不会。
# ════════════════════════════════════════════════════════════════════

# ── 0. 构建产物与本地工作区 ──────────────────────────────────────
out/
build/
.vs/
.vscode/
cmake-build-debug/
cmake-build-release/
*.exe
*.pdb
*.ilk
.DS_Store
.workbuddy/

# ── 1. UE 引擎生成物（打开工程自动重建，12 GB 里的 10.9 GB）──────
UE5/NaiwaP0/Binaries/
UE5/NaiwaP0/DerivedDataCache/
UE5/NaiwaP0/Intermediate/
UE5/NaiwaP0/Saved/
UE5/Records/ReimportBackups/

# ── 2. 历史 / 候选 / 诊断目录（体积主体，可重建或可重算）────────
#    P2 奶蛋低模候选：落选方案（运行时用的是 Art/Egg/ 那套），
#    由 build_naiwa_egg_features.py 一条命令重出。
UE5/NaiwaP0/Content/Naiwa/P2/Art/EggCandidates/
NaiwaCharacter/iterations/
NaiwaCharacter/**/trials_*/
NaiwaCharacter/**/before_*/
NaiwaCharacter/**/audit/
NaiwaCharacter/**/diagnostics/
NaiwaCharacter/**/repository_before_*/

# ── 3. 缓存、过程矩阵与自动备份 ─────────────────────────────────
__pycache__/
*.pyc
*.blend1
*.npz
*.ffconcat

# ── 4. 二进制源：只留复建链的头(R1)与尾(E2) + 两个动画源 ─────────
#    FBX 是 Blender↔UE 之间的中间交换格式，可由 .blend 一条命令重导，
#    且 UE 侧已有对应 .uasset，故整体不进库（15 个 / 277 MB）
*.fbx
NaiwaCharacter/**/*.blend
!NaiwaCharacter/Naiwa_Character.blend
!NaiwaCharacter/versions/20261007_N2_round_refinement/candidate_R1/Naiwa_Character.blend
!NaiwaCharacter/versions/20261007_H2_E2_overall_refinement/candidate_E2/Naiwa_Character.blend
!UE5/Animation/Run_v1/Naiwa_E2_Run.blend
!NaiwaAnimation_20261009/Naiwa_E2_Greeting_10s.blend
#    放回：奶蛋建模链 S0→S5 的 4 份中间 .blend 与 4 份交付 .fbx。
#    链上三个脚本互相以这几份 .blend 为输入，缺任一份整条链断在第一步，
#    且四变体 .blend 是多轮评测筛出的成品，重跑参数得不到同一结果。
!NaiwaCharacter/deliveries/NaiwaEgg_S0-S3/NaiwaEgg_S0-S3.blend
!NaiwaCharacter/deliveries/NaiwaEgg_S4-S5_v3_candidate/SK_NaiwaEgg_S4-S5.blend
!NaiwaCharacter/deliveries/NaiwaEgg_Features_v1/SK_NaiwaEgg_Chick.blend
!NaiwaCharacter/deliveries/NaiwaEgg_Features_v1/SK_NaiwaEgg_Mouse.blend
!NaiwaCharacter/deliveries/NaiwaEgg_Features_v1/SK_NaiwaEgg_Soy.blend
!NaiwaCharacter/deliveries/NaiwaEgg_Features_v1/SK_NaiwaEgg_Tea.blend
!NaiwaCharacter/deliveries/NaiwaEgg_Features_v1/SK_NaiwaEgg_Chick.fbx
!NaiwaCharacter/deliveries/NaiwaEgg_Features_v1/SK_NaiwaEgg_Mouse.fbx
!NaiwaCharacter/deliveries/NaiwaEgg_Features_v1/SK_NaiwaEgg_Soy.fbx
!NaiwaCharacter/deliveries/NaiwaEgg_Features_v1/SK_NaiwaEgg_Tea.fbx
#    放回：P2 拉弓动作的 FBX 导出，与同目录 .blend 成对
!UE5/Animation/P2_Archer/Naiwa_P2_SlingshotDraw.fbx

# ── 5. 序列帧、预览图与参考图（序列帧可由 .blend 重渲）──────────
NaiwaAnimation_20261009/frames/
NaiwaAnimation_20261009/preview/
*.png
*.jpg
*.jpeg
#    放回：造型参考输入（build_naiwa.py 的配色依据，属输入依赖）
!NaiwaCharacter/references/**/*.png
!NaiwaCharacter/references/**/*.jpg
#    放回：NaiwaCharacter 顶层 23 张交付预览图（README 引用）
!NaiwaCharacter/*.png
#    放回：UE5/Records 根级验收截图 + P1 验收证据截图
#    P0 各轮 review 目录下的截图（35 张 / 39 MB）仍排除：对应录像 mp4 已入库，
#    截图可由 run_stage.ps1 重跑再生。
!UE5/Records/*.png
!UE5/Records/p1_acceptance_20261018/*.png
# P1 正式 SFML 源素材：从旧版 out/build 拷贝并逐文件校验，须可由仓库恢复
!UE5/SourceAssets/SFML_Level1/png/*.png
#    放回：主菜单源图 6 张（开始画面 / 关卡卡立绘 / 4 张缩略图）
#    与缩略图裁切输入 4 张（Captures/）。create_menu_assets.py 与
#    create_level_thumbnails.py 直接读这两个目录，缺图就抛 FileNotFoundError。
!UE5/NaiwaP0/SourceAssets/MenuUI/*.png
!UE5/NaiwaP0/SourceAssets/MenuUI/Captures/*.png
#    P1 反馈素材：抠背景后的 96 帧死亡动画（直接对应 Content 内的 uasset）
#    与 3 张参照图，放行。
!UE5/SourceAssets/P1_Feedback/**/*.png
#    P2 失败提示图：透明原图用于重新导入 UI Texture2D
!UE5/SourceAssets/P2_FailureFeedback/**/*.png
#    P3 夜巡 2D 立绘输入与透明抠图（测试关及正式关卡直接使用）
!UE5/SourceAssets/P3/Portraits/**/*.png
!UE5/SourceAssets/P3/Audio/**/*.wav
!UE5/SourceAssets/P3/Audio/**/*.mp3
#    P5/P6 美术源文件（专用源资产目录）；Common 只收已批准的跨关卡资产
!UE5/SourceAssets/Common/**/*.png
!UE5/SourceAssets/P5/**/*.png
!UE5/SourceAssets/P6/**/*.png
!UE5/Records/p5_p6_plan/evidence/**/*.png
#    P4 生产美术与验收证据（W1 历史技术样图保持可重建/忽略）
!UE5/SourceAssets/P4/Characters/Alpha/**/*.png
!UE5/SourceAssets/P4/Environment/**/*.png
!UE5/SourceAssets/P4/UI/**/*.png
!UE5/Records/p4_alpha/evidence/**/*.png
#    P4 W1 放行的唯一视觉依据：标定画面修复前/后各一张 1920x1080，
#    环境再变就重截不出同一张，必须跟着记录走。
!UE5/Records/p4_alpha/*.png
#    P3 美术图集 7 张：p3_process_approved_art.py 的唯一输入，
#    9 张立绘中的 5 张与 28 张场景 sprite 均由这里裁出，AI 生成不可再生。
!UE5/Records/p3_m2/art_preview/*.png
#    P3 正式关设计图 2 张：与同目录的计划书、参数 json 属同一份交付，
#    注意 Records 的放行必须逐层写，只放行 Records 根级盖不到子目录。
!UE5/Records/p3_formal/design_reference/*.png
#    原始解码帧属中间输入，由视频一条命令重新抽帧，点名挡住（须在放行之后）。
UE5/SourceAssets/P1_Feedback/DeathLaughVideoFramesRaw/

# ── 6. 过程数据 ─────────────────────────────────────────────────
#    .gitignore 无法按文件体积过滤，故按「目录特征 + 文件名特征」排除。
#    这些文件的内容均已浓缩进同目录的 *_report.json / *_validation.json。
#
#    6a 原始对比与实验数据目录
NaiwaCharacter/**/comparisons/
NaiwaCharacter/**/research_eyes/
#    6b 截面逐点采样（N2 15.1 MB / candidate_H2 23.5 MB）
**/section_raw.json
#    6c 逐文件点名的超大过程文件
NaiwaCharacter/versions/20261006_head_neck_refinement/head_neck_validation.json
NaiwaCharacter/versions/20261006_head_neck_refinement/baseline_head_neck_inspection.json
NaiwaCharacter/versions/20261006_head_neck_refinement/candidate_N*/validation_report.json
NaiwaCharacter/versions/20261009_E2_C3_solver_revision/actual_sections_E2_B.csv
NaiwaCharacter/versions/20261009_E2_C3_solver_revision/candidate_B/validation_report.json
NaiwaCharacter/versions/20261009_E2_C3_solver_revision/selected_patch_diagnostic.json
NaiwaCharacter/versions/20261009_E2_C3_*/candidate_*/key_actual_sections.json
NaiwaCharacter/versions/20261009_E2_C3_*/baseline/measurements_*.json
NaiwaCharacter/versions/20261009_E2_C3_*/baseline/body_scope_release_frozen.csv
#    6d UE 自动测试的逐帧输入记录
UE5/Records/**/*.jsonl
#
#    ⚠️ 本节是「点名式」规则，新增同类大文件时不会自动命中。
#       提交前请跑一次核对（见 .workbuddy/memory/ 中的提交前检查步骤）。

# ── 7. 日志自动备份与编译迭代日志 ───────────────────────────────
UE5/Records/*-backup-*.log
#    编译 / 验证迭代日志：同参数重编即可再生，单个文件最大 31 MB。
#    注：已入库的 3 个 P0 构建日志不受影响（.gitignore 只作用于未跟踪文件）。
UE5/Records/*_build_*.log
UE5/Records/*_compile_*.log
#    P2 轮次日志：打包（package_development_*）、启动（runtime_*）、
#    物理回归（physics_*），同参数重跑即可再生，单个最大 10 MB。
UE5/Records/*.log
UE5/Records/*_stdout.txt
UE5/Records/*_stderr.txt
#    Blender / UE 导入导出日志与 C++ 编译中间产物
NaiwaCharacter/**/*.log
NaiwaCharacter/fbx_hierarchy_inspector.obj
# P1-0 本地完整 P0 快照体积较大；清单和复建说明纳管
UE5/Records/p1_20261015_baseline/*.zip

