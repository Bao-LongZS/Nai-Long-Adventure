          "first_ban_laugh": { "when": "B4 首次「禁笑令」生效，玩家按 E 被拒的那一刻", "emitted_by": "FNaiwaP4BossBrain（B4）→ 能力禁用回调" },
          "boss_break": { "when": "Boss 进入破防/硬直窗口首帧（B1 撞墙硬直）", "emitted_by": "FNaiwaP4BossBrain（通用 BreakWindow 状态进入）" },
